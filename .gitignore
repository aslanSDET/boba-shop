# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# AWS credentials — never commit these (e.g. accidental `aws ... > .aws` redirects)
.aws
.aws/
aws_credentials*
*access-key*.json

# Claude Code local settings (per-developer, not shared)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Clover spike scratch output (sandbox ids, tokens-adjacent, snapshots)
scripts/spike/.out/
assets/clover/_spike-*.json

# Generated by scripts/build-brief.mjs from CLOVER-AND-LAUNCH.md + docs/brief.tpl.html
docs/snowdaes-launch-brief.html

# Published artifact sources — KEPT, not ignored. These are re-publishable
# (no doctype/html/head/body: the Artifact tool wraps them) and are the record
# of work already paid for. See artifacts/README.md.
!artifacts/

# ── One-time research, kept local ────────────────────────────────────────────
# The sandbox spike was a throwaway harness: eight numbered probes that each
# answered one question and then stopped being useful. Nothing imports them,
# nothing builds them, and their conclusions live in the three .md files below
# which ARE tracked. Kept on disk because re-running one is occasionally handy;
# out of the repo because a reviewer should not have to scroll past them.
scripts/spike/*.mjs
scripts/spike/lib/
scripts/spike/README.md
!scripts/spike/findings.md
!scripts/spike/prior-art.md
!scripts/spike/payment-paths.md

# Generator for an artifact that is already published, plus a template only it
# reads, plus a copy of someone else's document.
scripts/build-brief.mjs
docs/brief.tpl.html
docs/yipyy-and-clover.html

# Written once for the PR body; it now lives on the PR.
docs/PR-DESCRIPTION.md

